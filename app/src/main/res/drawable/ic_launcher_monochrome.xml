<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed (one-colour) icon, Android 13+: the system tints everything one colour, so the card is drawn
  as an outline and the tape as a thin strip - the full "record" dot stays the strongest mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- card outline -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:pathData="M31,38 L77,35 Q79,35 79,37 L80,70 Q80,72 78,72 L32,74 Q30,74 30,72 L29,40 Q29,38 31,38 Z" />
    <!-- ruled lines -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.6"
        android:pathData="M35,64 L74,62.5 M35,68 L74,66.5" />
    <!-- tape, outline only -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:pathData="M24,40 L36,30 L44,38 L32,48 Z" />
    <!-- record dot -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M55,51 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />
</vector>
